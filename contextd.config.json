{
  "project": {
    "name": "context_master"
  },
  "triggers": {
    "event_count": 40,
    "token_threshold": 6000,
    "interval_seconds": 300
  },
  "budget": {
    "max_tokens_per_hour": 120000,
    "max_cost_per_session_usd": 0.5
  },
  "privacy": {
    "redact_secrets": true,
    "local_only": false
  },
  "models": {
    "tiers": {
      "cheap": {
        "provider": "claude-code",
        "model": "haiku",
        "max_output_tokens": 8192
      },
      "medium": {
        "provider": "claude-code",
        "model": "sonnet",
        "max_output_tokens": 8192
      },
      "high": {
        "provider": "claude-code",
        "model": "opus",
        "max_output_tokens": 8192
      }
    },
    "routing": {
      "classification": "cheap",
      "extraction": "cheap",
      "summarization": "cheap",
      "conflict_resolution": "medium",
      "complex_reconciliation": "medium",
      "learn": "medium"
    }
  },
  "accounting": {
    "agent_input_cost_per_mtok": 15
  },
  "limits": {
    "worker_timeout_ms": 300000
  }
}
